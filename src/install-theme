#!/usr/bin/env bash

set -euo pipefail

apt-get update && \
  apt-get install -y arc-kde arc-theme geeqie plasma-widgets-addons
rm -f /usr/share/wallpapers/Arc-Dark/contents/images/*
mkdir -p /usr/share/backgrounds/
# Standardized background location across all Kasm Images
cp /tmp/theme-src/bg_kasm.png /usr/share/backgrounds/bg_default.png
# Overwrite default theme background with the Kasm custom background
rm -f /usr/share/wallpapers/Arc-Dark/contents/images/1920x1080.png
ln -s /usr/share/backgrounds/bg_default.png /usr/share/wallpapers/Arc-Dark/contents/images/1920x1080.png
# Plasma Drawer Icon (Start Icon)
cp /tmp/theme-src/kasmos.svg /usr/share/icons/Papirus/22x22/apps/kasmos.svg
# KDE Start Plash Screen. Copy from KasmOS Bookworm theme due to new theme (Arc
# Dark) animation change.
splash_dir=/usr/share/plasma/look-and-feel/com.github.varlesh.arc-dark/contents/splash
rm -r "$splash_dir"
cp -a /tmp/theme-src/splash "$splash_dir"
